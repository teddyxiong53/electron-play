{
  "name": "electron-helloworld",
  "version": "1.0.0",
  "description": "Electron Hello World 示例程序",
  "main": "main.js",
  "scripts": {
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.example.electron-helloworld",
    "productName": "Electron示例程序",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "icon": "icon.png"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "24.6.3"
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  }
}
